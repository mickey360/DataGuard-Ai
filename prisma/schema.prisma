generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole { OWNER ADMIN ENGINEER ANALYST VIEWER }
enum SourceType { FILE API POSTGRES MYSQL OTHER }
enum RunStatus { RUNNING PASSED FAILED }
enum Severity { LOW MEDIUM HIGH CRITICAL }
enum IncidentStatus { OPEN ACKNOWLEDGED INVESTIGATING RESOLVED REOPENED }
enum RuleType { NOT_NULL UNIQUE RANGE REGEX ALLOWED_VALUES CUSTOM }

model Organization {
  id        String      @id @default(cuid())
  name      String
  createdAt DateTime    @default(now())
  workspaces Workspace[]
}

model Workspace {
  id           String       @id @default(cuid())
  organizationId String
  name         String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  sources      DataSource[]
  datasets     Dataset[]
  auditLogs    AuditLog[]
  @@index([organizationId])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  name        String?
  role        MemberRole @default(ANALYST)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, email])
}

model DataSource {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  type        SourceType
  config      Json?
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  datasets    Dataset[]
  @@index([workspaceId])
}

model Dataset {
  id          String      @id @default(cuid())
  workspaceId String
  sourceId    String?
  name        String
  schemaHash  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      DataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  rules       QualityRule[]
  runs        IngestionRun[]
  incidents   Incident[]
  @@index([workspaceId])
  @@index([sourceId])
}

model QualityRule {
  id          String   @id @default(cuid())
  datasetId   String
  column      String
  type        RuleType
  config      Json?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results     QualityResult[]
  incidents   Incident[]
  @@index([datasetId])
}

model IngestionRun {
  id             String      @id @default(cuid())
  datasetId      String
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  status         RunStatus   @default(RUNNING)
  rowCount       Int         @default(0)
  columnCount    Int         @default(0)
  qualityScore   Float?
  schemaHash     String?
  volumeDelta    Float?
  summary        Json?
  dataset        Dataset     @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results        QualityResult[]
  incidents      Incident[]
  @@index([datasetId, startedAt])
}

model QualityResult {
  id          String      @id @default(cuid())
  runId       String
  ruleId      String
  passed      Boolean
  failed      Int         @default(0)
  total       Int         @default(0)
  evidence    Json?
  createdAt   DateTime    @default(now())
  run         IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rule        QualityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  @@index([runId])
}

model Incident {
  id           String         @id @default(cuid())
  datasetId    String
  runId        String
  ruleId       String?
  severity     Severity
  status       IncidentStatus @default(OPEN)
  title        String
  message      String
  evidence     Json?
  openedAt     DateTime       @default(now())
  resolvedAt   DateTime?
  dataset      Dataset        @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  run          IngestionRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  rule         QualityRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  investigations AIInvestigation[]
  @@index([datasetId, status])
}

model AIInvestigation {
  id           String   @id @default(cuid())
  incidentId   String
  provider     String
  model        String?
  headline     String?
  cause        String?
  evidence     Json?
  nextSteps    Json?
  confidence   String?
  createdAt    DateTime @default(now())
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  @@index([incidentId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  action      String
  actorEmail  String?
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}
